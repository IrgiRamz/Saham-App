# Salin file ini menjadi .env dan isi dengan nilai ASLI di server saja.
# JANGAN PERNAH commit file .env — file ini hanya template placeholder.
PORT=8000
GOWA_URL=https://contoh-gowa-kamu.id
GOWA_DEVICE_ID=isi-device-id
GOWA_TARGET_PHONE=628xxxxxxxxxx
GOWA_BASIC_USER=isi-username-gowa
GOWA_BASIC_PASSWORD=isi-password-gowa
SECRET_CRON_KEY=ganti-dengan-string-acak-panjang
MIN_DAILY_TURNOVER=3000000000.0
MAX_SIGNAL_NOTIFICATIONS=3
